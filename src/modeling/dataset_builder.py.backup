import numpy as np
import pandas as pd

def build_feature_matrix(lst, albedo, net_rad, ndvi, ndbi, ndvi_mean, albedo_mean, true_svf, z0, dist_water, dist_veg, c_g):
    features = {
        'LST_Celsius': lst.flatten(),
        'Albedo_Liang_S2': albedo.flatten(),
        'Net_Radiation_Rn_Indep': net_rad.flatten(),
        'NDVI_Greenness': ndvi.flatten(),
        'NDBI_Built_Index': ndbi.flatten(),
        'NDVI_Neighborhood_Mean': ndvi_mean.flatten(),
        'Albedo_Neighborhood_Mean': albedo_mean.flatten(),
        'True_Sky_View_Factor': true_svf.flatten(),
        'Aerodynamic_Roughness_z0': z0.flatten(),
        'Distance_to_Water': dist_water.flatten(),
        'Distance_to_Vegetation': dist_veg.flatten(),
        'Thermal_Admittance_cG': c_g.flatten()
    }
    return pd.DataFrame(features)
